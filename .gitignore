# host-specific settings and secrets
.env
# large artifacts recreated by scripts
models/
media/*.mp4
media/*.mkv
media/*.webm
media/src/
# Frigate runtime data
# (Frigate keeps its db/secrets in /config, so whitelist only the files we author)
frigate/config/*
!frigate/config/config.yml
!frigate/config/labelmap-*.txt
frigate/media/
.cache/
# offline bundles
*.tar
*.tar.gz
*.tgz
# test logs
logs/
