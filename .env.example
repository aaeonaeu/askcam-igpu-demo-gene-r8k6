# Copy to .env and adjust for this host (group IDs differ per machine):
#   getent group video render
VIDEO_GID=44
RENDER_GID=990

# --- VLM (llama.cpp server, Vulkan on the iGPU) ---
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan
# qwen = Qwen2.5-VL-3B (default), gemma = Gemma-3-4B (alternative)
VLM_MODEL=qwen
VLM_PORT=8080
VLM_CTX=8192
VLM_PARALLEL=2
# max image tokens per image (lower = faster, less detail)
VLM_IMAGE_MAX_TOKENS=1024
