# Copy to .env and adjust for this host (group IDs differ per machine):
#   getent group video render
VIDEO_GID=44
RENDER_GID=990

# --- VLM (llama.cpp router, Vulkan on the iGPU) ---
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan@sha256:15fd15e1f1d2ab2daf4b0b88f5849d95764c155237f36e8f5d36b32a4cec1be9
# Models and their settings (context, slots, image tokens) are in vlm/models.ini and are switched
# at runtime from the askcam-ui "Model" menu. Download files with scripts/fetch-models.sh qwen|gemma|qwen7b.
VLM_PORT=8080

# --- Simulated cameras (mediamtx + ffmpeg) ---
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.21.3-ffmpeg@sha256:208e9f1740a09a5ee63b6308e77ce0d54fce0456462f640e6bd9acfc62ebb5a2
RTSP_PORT=8554

# --- Frigate (ROCm image, detection on the iGPU) ---
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.18.2-rocm@sha256:d659f0967627e7bd0b29c96bc396e436ce041aa40bf19e213f02bdade6092a83
FRIGATE_UI_PORT=8971

# --- vlm-gate (limits Frigate GenAI calls to the VLM) ---
NGINX_IMAGE=nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
VLM_GATE_CONCURRENCY=1
# 8/min with concurrency 1 keeps detection skips ~0 next to the VLM (NOTES.md step 4)
VLM_GATE_RATE=8r/m

# --- askcam-ui (booth demo page) ---
UI_PORT=8000
