# Copy to .env and adjust for this host (group IDs differ per machine):
#   getent group video render
VIDEO_GID=44
RENDER_GID=990

# --- VLM (llama.cpp server, Vulkan on the iGPU) ---
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan
# Model files inside ./models (fetch with scripts/fetch-models.sh qwen|gemma)
# Default: Qwen2.5-VL-3B-Instruct Q4_K_M
VLM_MODEL_FILE=Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
VLM_MMPROJ_FILE=mmproj-Qwen2.5-VL-3B-Instruct-Q8_0.gguf
# Alternative: Gemma-3-4B-it
#VLM_MODEL_FILE=gemma-3-4b-it-Q4_K_M.gguf
#VLM_MMPROJ_FILE=mmproj-gemma-3-4b-it-f16.gguf
VLM_ALIAS=vlm
VLM_PORT=8080
VLM_CTX=8192
VLM_PARALLEL=2
# max image tokens per image: 1024 = most detail (~5 s), 512 = default (~2.5 s), 256 = fastest (~1.3 s)
VLM_IMAGE_MAX_TOKENS=512

# --- Simulated cameras (mediamtx + ffmpeg) ---
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.21.3-ffmpeg
RTSP_PORT=8554

# --- Frigate (ROCm image, detection on the iGPU) ---
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.18.2-rocm
FRIGATE_UI_PORT=8971
